{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python manage.py collectstatic --noinput",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{venv/**,.venv/**,**/__pycache__/**,**/*.pyc,db.sqlite3,media/**,staticfiles/**}"
    }
  }
}
